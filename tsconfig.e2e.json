{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.e2e.tsbuildinfo",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["e2e/**/*", "src/renderer/src/env.d.ts", "playwright.config.ts", "src/shared/**/*"]
}
